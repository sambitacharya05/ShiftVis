# ShiftVis Configuration

# Preprocessor
PREPROCESSOR_TARGET_COLOR_MODE=BGR
PREPROCESSOR_MIN_DIM=256
PREPROCESSOR_MAX_DIM=10000
PREPROCESSOR_ALLOW_RESIZE=True

# Segmentor
SEGMENT_SIZE=256
SEGMENT_OVERLAP_PERCENTAGE=0.10

# Aligner
ALIGNER_LOCAL_SEARCH_RADIUS=20
ALIGNER_LARGE_SEARCH_RADIUS=50
ALIGNER_TIER1_THRESHOLD=0.98
ALIGNER_TIER2_THRESHOLD=0.90
ALIGNER_ENTROPY_THRESHOLD=0.5
ALIGNER_VARIANCE_THRESHOLD=5.0

# Validator
VALIDATOR_OUTLIER_THRESHOLD=1.0
VALIDATOR_CONSISTENCY_THRESHOLD=0.7

# Comparator
COMPARATOR_SIGNIFICANCE_THRESHOLD=0.2
COMPARATOR_MATCH_THRESHOLD=0.95
COMPARATOR_CHANGE_THRESHOLD=1.0
